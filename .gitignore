# ── API keys and secrets — NEVER commit ──────────────────────
.env
*.env
config.py
secrets.py
client_secret.json
google-ads.yaml
*.yaml

# ── Claude Code project instructions — local only, not for GitHub ─
CLAUDE.md

# ── Python cache / build ─────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# ── OS files ─────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Generated data / artifacts (never source) ────────────────
blogheading.tar
output/
output_images/
logs/
*.log
*.jsonl

# Generated media + data dumps (template assets are committed explicitly)
*.png
*.jpg
*.jpeg
*.webp
*.json

# ...except the template pool's own metadata, which must stay tracked
# (read by content_engine/image_module/template_selector.py at runtime) --
# previously only finance/ and general/ were exempted by accident, leaving
# the other 5 categories' descriptions untracked and at risk of being lost.
!content_engine/templates/*/image_descriptions.json
